/* ═══════════════════════════════════════════════════════════════════════════
   SYN·APSE TUI — professional Claude Code theme
   Warm graphite surfaces · terracotta brand accent · hairline borders
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Design tokens ───────────────────────────────────────────────────────── */

$bg: #1a1917;
$surface: #201f1c;
$surface-2: #242220;
$surface-3: #2c2a27;
$input-bg: #141311;
$feed-bg: #171614;

$border: #38352f;
$border-2: #524e45;

$text: #e8e4dc;
$text-dim: #a8a196;
$text-faint: #6e685d;

$accent: #d97757;
$accent-hi: #e89173;
$accent-deep: #b35c3e;
$on-accent: #1c0f07;

$green: #69b583;
$teal: #56a8a0;
$cyan: #6ba5c9;
$blue: #7a9ec9;
$purple: #a68ec9;
$pink: #c983a2;
$yellow: #d8b04c;
$orange: #d9864a;
$red: #e5534b;

/* ─── Globals ─────────────────────────────────────────────────────────────── */

Screen {
    background: $bg;
    color: $text;
    layers: base overlay notifications;
}

/* ─── Header (SynapseHeader) ──────────────────────────────────────────────── */

SynapseHeader {
    background: $surface;
    color: $text;
    dock: top;
    height: 1;
    padding: 0 2;
    border-bottom: solid $border;
}

/* ─── Command bar (CommandBar) ────────────────────────────────────────────── */

CommandBar {
    background: $surface;
    color: $text-dim;
    dock: bottom;
    height: 3;
    padding: 0 1;
    border-top: solid $border;
}

#cmd-input {
    border: none;
    background: transparent;
    padding: 0 1;
}

#cmd-input:focus {
    border: none;
}

/* ─── Footer ─────────────────────────────────────────────────────────────── */

Footer {
    background: $surface;
    color: $text-dim;
    dock: bottom;
    height: 1;
    border-top: solid $border;
}

FooterKey {
    background: transparent;
}

FooterKey > .footer-key--key {
    background: $surface-3;
    color: $accent-hi;
    text-style: bold;
}

FooterKey:hover > .footer-key--key {
    background: $accent;
    color: $on-accent;
}

FooterKey > .footer-key--description {
    color: $text-dim;
}

FooterLabel {
    color: $text-faint;
}

/* ─── Layout ──────────────────────────────────────────────────────────────── */

#app-layout {
    layout: horizontal;
    height: 1fr;
}

/* ─── Session Sidebar ─────────────────────────────────────────────────────── */

SessionSidebar {
    width: 30;
    min-width: 24;
    max-width: 44;
    background: $surface;
    border-right: solid $border;
    padding: 0;
    height: 1fr;
}

SessionSidebar > Vertical {
    height: 1fr;
}

SessionSidebar .sidebar-title {
    color: $text-dim;
    text-style: bold;
    padding: 0 1;
    border-bottom: solid $border;
    background: $surface-2;
    width: 1fr;
    height: 1;
}

SessionSidebar .sidebar-empty {
    color: $text-faint;
    margin: 2 1;
    text-style: italic;
}

SessionSidebar ListView {
    background: transparent;
    border: none;
    height: 1fr;
    padding: 0;
}

SessionSidebar ListItem {
    padding: 1 1;
    border-bottom: solid #28251f;
    background: transparent;
    height: auto;
}

SessionSidebar ListItem:hover {
    background: $surface-3;
}

SessionSidebar ListItem.--highlight {
    background: $surface-3;
    border-left: tall $accent;
}

SessionSidebar ListItem.selected-item {
    background: $surface-3;
    border-left: tall $accent-hi;
}

/* ─── Main Content Area ───────────────────────────────────────────────────── */

#main-content {
    background: $bg;
    height: 1fr;
    width: 1fr;
}

/* ─── Tabs ────────────────────────────────────────────────────────────────── */

TabbedContent {
    background: $bg;
    height: 1fr;
}

TabbedContent > ContentSwitcher {
    background: $bg;
    height: 1fr;
}

TabPane {
    background: $bg;
    padding: 0;
    height: 1fr;
}

Tabs {
    background: $surface;
    border-bottom: solid $border;
}

Tabs > Tab {
    color: $text-faint;
    padding: 0 2;
    background: transparent;
    text-style: bold;
}

Tabs > Tab:hover {
    color: $text-dim;
    background: $surface-3;
}

Tabs > Tab.-active {
    color: $text;
    background: $bg;
    border-bottom: tall $accent;
    text-style: bold;
}

/* ─── Shared panel chrome ─────────────────────────────────────────────────── */

.dashboard-title {
    color: $text;
    text-style: bold;
    padding: 0 1;
    border-bottom: solid $border;
    background: $surface-2;
    width: 1fr;
    height: 1;
}

.panel-subtitle {
    color: $text-faint;
    text-style: bold;
    padding: 0 1;
    border-bottom: solid #28251f;
    background: $surface;
}

.panel-hint {
    color: $text-faint;
    text-style: italic;
    margin: 1 1;
}

/* ─── Orchestration Dashboard ─────────────────────────────────────────────── */

OrchestrationDashboard {
    background: $bg;
    height: 1fr;
}

OrchestrationDashboard > Vertical {
    height: 1fr;
}

#dash-top {
    height: 16;
    border-bottom: solid $border;
}

#runs-panel {
    width: 1fr;
    background: $bg;
    border-right: solid $border;
    height: 1fr;
}

#runs-content {
    padding: 0 1;
    height: auto;
}

#feed-panel {
    width: 1fr;
    background: $bg;
    height: 1fr;
}

#feed-content {
    padding: 0;
    height: auto;
}

#stages-panel {
    height: 10;
    border-bottom: solid $border;
}

#cost-panel {
    height: 1fr;
}

RunCard {
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    border: solid $border;
    background: $surface;
}

RunCard.status-running {
    border: tall $green;
    background: #1d2320;
}

RunCard.status-completed {
    border: solid $teal;
}

RunCard.status-failed {
    border: solid $red;
}

RunCard.status-pending {
    border: solid $border;
}

/* ─── Session Terminal ────────────────────────────────────────────────────── */

SessionTerminal {
    background: $feed-bg;
    border: solid $border;
    height: 1fr;
}

#terminal-scroll {
    background: $feed-bg;
    height: 1fr;
    padding: 0;
}

#terminal-log {
    background: $feed-bg;
    color: $text-dim;
    height: 1fr;
    padding: 1 1;
}

/* ─── Agent Mailbox ───────────────────────────────────────────────────────── */

AgentMailbox {
    background: $bg;
    height: 1fr;
}

AgentMailbox > Vertical {
    height: 1fr;
}

#mailbox-top {
    height: 1fr;
    border-bottom: solid $border;
}

#inbox-panel {
    width: 40%;
    border-right: solid $border;
    background: $bg;
    padding: 0;
}

#inbox-content {
    color: $text-dim;
    padding: 1;
    height: 1fr;
}

#thread-panel {
    width: 1fr;
    background: $bg;
    padding: 0;
}

#thread-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

#compose-area {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#compose-input {
    margin: 0 1 0 0;
    height: 3;
}

#send-btn {
    height: 3;
    margin: 0 1 0 0;
    background: $accent;
    color: $on-accent;
    border: none;
    text-style: bold;
}

#send-btn:hover {
    background: $accent-hi;
}

#broadcast-btn {
    height: 3;
    background: $surface-3;
    color: $purple;
    border: solid $border-2;
}

#broadcast-btn:hover {
    background: $border-2;
    color: $text;
}

/* ─── Overview panel ──────────────────────────────────────────────────────── */

OverviewPanel {
    background: $bg;
    height: 1fr;
}

OverviewPanel > Vertical {
    height: 1fr;
}

#overview-scroll {
    height: 1fr;
    padding: 0 1;
}

#overview-content {
    height: auto;
    padding: 1;
}

.stat-grid {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.stat-card {
    width: 1fr;
    height: 5;
    margin: 0 1 0 0;
    padding: 1;
    border: solid $border;
    background: $surface;
}

.stat-card .stat-label {
    color: $text-faint;
    text-style: bold;
}

.stat-card .stat-value {
    color: $text;
    text-style: bold;
    margin-top: 1;
}

/* ─── Tasks panel ─────────────────────────────────────────────────────────── */

TaskBoard {
    background: $bg;
    height: 1fr;
}

TaskBoard > Vertical {
    height: 1fr;
}

#tasks-body {
    height: 1fr;
    border-bottom: solid $border;
}

#tasks-list {
    width: 1fr;
    border-right: solid $border;
    background: $bg;
}

#task-detail {
    width: 1fr;
    background: $bg;
    padding: 0 1;
}

#task-detail-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

#tasks-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#tasks-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── Automations panel ───────────────────────────────────────────────────── */

AutomationPanel {
    background: $bg;
    height: 1fr;
}

AutomationPanel > Vertical {
    height: 1fr;
}

#automations-body {
    height: 1fr;
    border-bottom: solid $border;
}

#automations-list {
    width: 55%;
    border-right: solid $border;
    background: $bg;
}

#automation-detail {
    width: 1fr;
    background: $bg;
    padding: 0 1;
}

#automation-detail-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

#automation-history {
    height: 10;
    border-top: solid $border;
}

#automation-history-content {
    color: $text-dim;
    padding: 0 1;
    height: auto;
}

#automations-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#automations-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── Knowledge panel ─────────────────────────────────────────────────────── */

KnowledgePanel {
    background: $bg;
    height: 1fr;
}

KnowledgePanel > Vertical {
    height: 1fr;
}

#knowledge-body {
    height: 1fr;
    border-bottom: solid $border;
}

#knowledge-list {
    width: 45%;
    border-right: solid $border;
    background: $bg;
}

#knowledge-detail {
    width: 1fr;
    background: $bg;
    padding: 0 1;
}

#knowledge-detail-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

#knowledge-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#knowledge-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── Transcripts panel ───────────────────────────────────────────────────── */

TranscriptPanel {
    background: $bg;
    height: 1fr;
}

TranscriptPanel > Vertical {
    height: 1fr;
}

#transcripts-body {
    height: 1fr;
    border-bottom: solid $border;
}

#transcripts-list {
    width: 45%;
    border-right: solid $border;
    background: $bg;
}

#transcript-detail {
    width: 1fr;
    background: $bg;
    padding: 0 1;
}

#transcript-detail-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

#transcript-search-row {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

/* ─── Hooks panel ─────────────────────────────────────────────────────────── */

HooksPanel {
    background: $bg;
    height: 1fr;
}

HooksPanel > Vertical {
    height: 1fr;
}

#hooks-table-wrap {
    height: 1fr;
    padding: 0 1;
    border-bottom: solid $border;
}

#hooks-lifecycle {
    height: 12;
    padding: 0 1;
    border-bottom: solid $border;
}

#hooks-lifecycle-content {
    height: auto;
}

#hooks-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#hooks-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── System panel ────────────────────────────────────────────────────────── */

SystemPanel {
    background: $bg;
    height: 1fr;
}

SystemPanel > Vertical {
    height: 1fr;
}

#system-scroll {
    height: 1fr;
    padding: 0 1;
}

#system-content {
    height: auto;
    padding: 1;
}

#system-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#system-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── Relay panel ─────────────────────────────────────────────────────────── */

RelayPanel {
    background: $bg;
    height: 1fr;
}

RelayPanel > Vertical {
    height: 1fr;
}

#relay-scroll {
    height: 1fr;
    padding: 0 1;
}

#relay-content {
    height: auto;
    padding: 1;
}

.relay-status-card {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    border: solid $border;
    background: $surface;
}

#relay-actions {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-top: solid $border;
}

#relay-actions Button {
    height: 3;
    margin: 0 1 0 0;
}

/* ─── Activity feed panel ─────────────────────────────────────────────────── */

ActivityFeed {
    background: $bg;
    height: 1fr;
}

ActivityFeed > Vertical {
    height: 1fr;
}

#activity-scroll {
    height: 1fr;
}

#activity-content {
    color: $text-dim;
    padding: 1;
    height: auto;
}

/* ─── List views used by utility panels ───────────────────────────────────── */

ListView {
    background: transparent;
    border: none;
    height: 1fr;
    padding: 0;
}

ListView ListItem {
    padding: 1 1;
    border-bottom: solid #28251f;
    background: transparent;
    height: auto;
}

ListView ListItem:hover {
    background: $surface-3;
}

ListView ListItem.--highlight {
    background: $surface-3;
    border-left: tall $accent;
}

ListView ListItem.selected-item {
    background: $surface-3;
    border-left: tall $accent-hi;
}

/* ─── DataTable ───────────────────────────────────────────────────────────── */

DataTable {
    background: $bg;
    color: $text-dim;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $text-faint;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $surface-3;
    color: $accent-hi;
}

DataTable > .datatable--cursor {
    background: $surface-3;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $bg;
}

DataTable > .datatable--hover {
    background: $surface-3;
}

/* ─── Input ───────────────────────────────────────────────────────────────── */

Input {
    background: $input-bg;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: tall $accent;
}

Input > .input--placeholder {
    color: $text-faint;
}

/* ─── TextArea ────────────────────────────────────────────────────────────── */

TextArea {
    background: $input-bg;
    color: $text;
    border: solid $border;
}

TextArea:focus {
    border: tall $accent;
}

/* ─── Button ──────────────────────────────────────────────────────────────── */

Button {
    background: $surface-3;
    color: $text;
    border: solid $border-2;
}

Button:hover {
    background: $border-2;
}

Button.-primary {
    background: $accent;
    color: $on-accent;
    border: none;
    text-style: bold;
}

Button.-primary:hover {
    background: $accent-hi;
}

Button.-success {
    background: $green;
    color: #0d2015;
    border: none;
    text-style: bold;
}

Button.-success:hover {
    background: #85c99b;
}

Button.-error {
    background: $red;
    color: #2a0e0c;
    border: none;
    text-style: bold;
}

Button.-error:hover {
    background: #ef7a74;
}

/* ─── Log ─────────────────────────────────────────────────────────────────── */

Log {
    background: $feed-bg;
    color: $text-dim;
    padding: 0;
}

/* ─── Select & options ────────────────────────────────────────────────────── */

Select {
    background: $input-bg;
    color: $text;
    border: solid $border;
    padding: 0 1;
}

Select:focus {
    border: tall $accent;
}

SelectOverlay > Option {
    background: $bg;
    color: $text-dim;
    padding: 0 1;
}

SelectOverlay > Option:hover {
    background: $surface-3;
    color: $text;
}

SelectOverlay > Option.-highlighted {
    background: $surface-3;
    color: $accent-hi;
}

/* ─── ScrollableContainer ─────────────────────────────────────────────────── */

ScrollableContainer {
    scrollbar-color: $border-2;
    scrollbar-color-hover: $accent;
    scrollbar-background: $bg;
    scrollbar-background-hover: $surface;
}

/* ─── Toast Notifications ─────────────────────────────────────────────────── */

Toast {
    background: $surface-2;
    border: tall $accent;
    color: $text;
}

ToastTitle {
    color: $accent-hi;
    text-style: bold;
}

ToastDescription {
    color: $text-dim;
}

Toast.-information {
    border: tall $cyan;
    background: #1e2931;
}

Toast.-information ToastTitle {
    color: $cyan;
}

Toast.-warning {
    border: tall $yellow;
    background: #342d1c;
}

Toast.-warning ToastTitle {
    color: $yellow;
}

Toast.-error {
    border: tall $red;
    background: #362220;
}

Toast.-error ToastTitle {
    color: $red;
}

Toast.-success {
    border: tall $green;
    background: #1f2f26;
}

Toast.-success ToastTitle {
    color: $green;
}

/* ─── Modal dialog (shared chrome) ────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: rgba(13, 12, 10, 0.82);
}

#dialog {
    background: $surface-2;
    border: round $accent-deep;
    padding: 1 3;
    width: 68;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
}

#dialog-title {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
    padding-bottom: 0;
    border-bottom: solid $border;
    height: 1;
}

#dialog Label {
    color: $text-dim;
    text-style: bold;
    margin-top: 1;
}

#dialog Input,
#dialog Select,
#dialog TextArea {
    margin-top: 0;
    background: $input-bg;
    border: solid $border;
    color: $text;
}

#dialog Input:focus,
#dialog Select:focus,
#dialog TextArea:focus {
    border: tall $accent;
}

#dialog-buttons {
    margin-top: 1;
    align: right middle;
    height: 3;
}

#dialog-buttons Button {
    height: 3;
    margin-left: 1;
}

#create-btn {
    background: $accent;
    border: none;
    color: $on-accent;
}

#create-btn:hover {
    background: $accent-hi;
}

#cancel-btn {
    background: $surface-3;
    border: solid $border-2;
    color: $text-dim;
}

#cancel-btn:hover {
    background: $border-2;
}

.field-hint {
    color: $text-faint;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

/* ─── Help overlay ────────────────────────────────────────────────────────── */

#help-panel {
    width: 76;
    height: auto;
    max-height: 90%;
    background: $surface-2;
    border: round $accent-deep;
    padding: 1 3;
    overflow-y: auto;
}

#help-title {
    color: $text;
    text-style: bold;
    height: 1;
    border-bottom: solid $border;
    margin-bottom: 1;
}

#help-content {
    color: $text-dim;
    height: auto;
}

#help-hint {
    color: $text-faint;
    height: 1;
    margin-top: 1;
}

/* ─── Status colour helpers ───────────────────────────────────────────────── */

.status-idle        { color: $text-dim; }
.status-working     { color: $green; }
.status-active      { color: $green; }
.status-running     { color: $green; }
.status-blocked     { color: $red; }
.status-done        { color: $cyan; }
.status-completed   { color: $teal; }
.status-error       { color: $red; }
.status-failed      { color: $red; }
.status-unreachable { color: $yellow; }
.status-paused      { color: $yellow; }
.status-pending     { color: $text-faint; }
.status-todo        { color: $text-dim; }
.status-in_progress { color: $yellow; }

/* ─── ProgressBar ─────────────────────────────────────────────────────────── */

ProgressBar {
    height: 1;
}

ProgressBar > .bar--complete {
    color: $accent;
}

ProgressBar > .bar--indeterminate {
    color: $cyan;
}

ProgressBar > .bar--bar {
    color: $border;
}

/* ─── Perf HUD ───────────────────────────────────────────────────────────── */

#perf-hud {
    background: rgba(32, 31, 28, 0.94);
    border: tall $border-2;
    color: $text-dim;
    dock: right;
    width: 34;
    height: auto;
    max-height: 50%;
    padding: 1;
    layer: overlay;
    visibility: hidden;
}

#perf-hud.visible {
    visibility: visible;
}

.perf-title {
    color: $yellow;
    text-style: bold;
    border-bottom: solid $border;
    margin-bottom: 1;
}

.perf-row {
    color: $text-dim;
    height: 1;
}

/* ─── Boot screen ─────────────────────────────────────────────────────────── */

BootScreen {
    background: $bg;
    align: center middle;
}

#boot-box {
    width: auto;
    height: auto;
    align: center middle;
}

#boot-logo {
    color: $text;
    text-align: center;
    height: 7;
}

#boot-status {
    height: 1;
    text-align: center;
    color: $text-dim;
    margin-top: 1;
}

#boot-bar {
    height: 1;
    text-align: center;
    margin-top: 1;
}

#boot-hint {
    color: $text-faint;
    text-align: center;
    margin-top: 1;
}

#boot-version {
    color: $text-faint;
    dock: bottom;
    height: 1;
    padding: 0 2;
    text-align: right;
}

/* ─── ASCII loader widgets ────────────────────────────────────────────────── */

AsciiLoading {
    height: 1;
    color: $cyan;
    margin: 0 1;
}

ProgressBarLoader {
    height: 1;
    margin: 0 1;
}

/* ─── Loader showcase screen ──────────────────────────────────────────────── */

#loader-showcase {
    width: auto;
    height: auto;
    margin: 3 6;
    padding: 0;
    border: tall $border;
    background: $surface-2;
    align: left top;
}

#showcase-title {
    color: $text;
    text-style: bold;
    padding: 0 1;
    height: 1;
    border-bottom: solid $border;
    background: $surface-3;
}

#showcase-spacer {
    height: 1;
}

#showcase-hint {
    color: $text-faint;
    margin: 1 1;
}

/* ─── LoadingIndicator (built-in) ─────────────────────────────────────────── */

LoadingIndicator {
    color: $accent-hi;
    background: rgba(32, 31, 28, 0.9);
}
