/* ═══════════════════════════════════════════════════════════════════════════
   SYN·APSE TUI — Claude Code premium theme
   Warm charcoal panels · terracotta brand accent · vibrant neon statuses
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Globals ─────────────────────────────────────────────────────────────── */

Screen {
    background: #0e0c12;
    color: #efe9e0;
    layers: base overlay notifications;
}

/* ─── Header (SynapseHeader) ──────────────────────────────────────────────── */

SynapseHeader {
    background: #15131c;
    color: #efe9e0;
    dock: top;
    height: 2;
    padding: 0 2;
    border-bottom: solid #262230;
}

SynapseHeader:focus {
    border-bottom: double #d97757;
}

/* ─── Prompt bar (PromptBar) ──────────────────────────────────────────────── */

PromptBar {
    background: #15131c;
    color: #968ba2;
    dock: bottom;
    height: 1;
    padding: 0 2;
    border-top: solid #262230;
}

/* ─── Footer ─────────────────────────────────────────────────────────────── */

Footer {
    background: #111018;
    color: #968ba2;
    dock: bottom;
    height: 1;
    border-top: solid #262230;
}

FooterKey {
    background: transparent;
}

FooterKey > .footer-key--key {
    background: #241d28;
    color: #ff8a5c;
    text-style: bold;
}

FooterKey:hover > .footer-key--key {
    background: #d97757;
    color: #1c0f07;
}

FooterKey > .footer-key--description {
    color: #8d8294;
}

FooterLabel {
    color: #5f566c;
/* ─── Layout ──────────────────────────────────────────────────────────────── */

#app-layout {
    layout: horizontal;
    height: 1fr;
}

/* ─── Session Sidebar ─────────────────────────────────────────────────────── */

SessionSidebar {
    width: 30;
    min-width: 24;
    max-width: 44;
    background: #111018;
    border-right: solid #262230;
    padding: 0;
    height: 1fr;
}

SessionSidebar > Vertical {
    height: 1fr;
}

SessionSidebar .sidebar-title {
    color: #ffd166;
    text-style: bold;
    padding: 1 1;
    border-bottom: solid #262230;
    background: #15131c;
    width: 1fr;
    height: 3;
}

SessionSidebar .sidebar-empty {
    color: #5f566c;
    margin: 2 1;
    text-style: italic;
}

SessionSidebar ListView {
    background: transparent;
    border: none;
    height: 1fr;
    padding: 0;
}

SessionSidebar ListItem {
    padding: 1 1;
    border-bottom: solid #191621;
    background: transparent;
    height: auto;
}

SessionSidebar ListItem:hover {
    background: #1c1825;
}

SessionSidebar ListItem.--highlight {
    background: #241d28;
    border-left: tall #d97757;
}

SessionSidebar ListItem.selected-item {
    background: #221c2a;
    border-left: tall #ff8a5c;
}

/* ─── Main Content Area ───────────────────────────────────────────────────── */

#main-content {
    background: #0e0c12;
    height: 1fr;
    width: 1fr;
}

/* ─── Tabs ────────────────────────────────────────────────────────────────── */

TabbedContent {
    background: #0e0c12;
    height: 1fr;
}

TabbedContent > ContentSwitcher {
    background: #0e0c12;
    height: 1fr;
}

TabPane {
    background: #0e0c12;
    padding: 0;
    height: 1fr;
}

Tabs {
    background: #15131c;
    border-bottom: solid #262230;
}

Tabs > Tab {
    color: #7a6f88;
    padding: 0 3;
    background: transparent;
}

Tabs > Tab:hover {
    color: #efe9e0;
    background: #1c1825;
}

Tabs > Tab.-active {
    color: #ff8a5c;
    background: #0e0c12;
/* ─── Orchestration Dashboard ─────────────────────────────────────────────── */

OrchestrationDashboard {
    background: #0e0c12;
    height: 1fr;
}

OrchestrationDashboard > Vertical {
    height: 1fr;
}

.dashboard-title {
    color: #3ddc97;
    text-style: bold;
    padding: 1 1;
    border-bottom: solid #262230;
    background: #15131c;
    width: 1fr;
    height: 3;
}

.dashboard-title .dashboard-spinner {
    color: #ff8a5c;
}

.panel-subtitle {
    color: #c792ea;
    text-style: italic bold;
    padding: 0 1;
    border-bottom: solid #191621;
    background: #111018;
}

#dash-top {
    height: 16;
    border-bottom: solid #262230;
}

#runs-panel {
    width: 1fr;
    background: #0e0c12;
    border-right: solid #262230;
    height: 1fr;
}

#runs-content {
    padding: 0 1;
    height: auto;
}

#feed-panel {
    width: 1fr;
    background: #0e0c12;
    height: 1fr;
}

#feed-content {
    padding: 0;
    height: auto;
}

#stages-panel {
    height: 10;
    border-bottom: solid #262230;
}

#cost-panel {
    height: 1fr;
}

RunCard {
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    border: solid #262230;
    background: #15131c;
}

RunCard.status-running {
    border: tall #3ddc97;
    background: #101a19;
}

RunCard.status-completed {
    border: solid #2be0c8;
}

RunCard.status-failed {
    border: solid #ff5d6b;
}

RunCard.status-pending {
    border: solid #262230;
}
    border-top: tall #d97757;
    text-style: bold;
}

/* ─── Session Terminal ────────────────────────────────────────────────────── */

SessionTerminal {
    background: #100e16;
    border: solid #262230;
    height: 1fr;
}

#terminal-scroll {
    background: #100e16;
    height: 1fr;
    padding: 0;
}

#terminal-log {
    background: #100e16;
    color: #968ba2;
    height: 1fr;
    padding: 1 1;
}
}
/* ─── Agent Mailbox ───────────────────────────────────────────────────────── */

AgentMailbox {
    background: #0e0c12;
    height: 1fr;
}

AgentMailbox > Vertical {
    height: 1fr;
}

#mailbox-top {
    height: 1fr;
    border-bottom: solid #262230;
}

#inbox-panel {
    width: 40%;
    border-right: solid #262230;
    background: #0e0c12;
    padding: 0;
}

#inbox-content {
    color: #bcb1c6;
    padding: 1;
    height: 1fr;
}

#thread-panel {
    width: 1fr;
    background: #0e0c12;
    padding: 0;
}

#thread-content {
    color: #bcb1c6;
    padding: 1;
    height: auto;
}

#compose-area {
    height: 3;
    padding: 0 1;
    background: #15131c;
    border-top: solid #262230;
}

#compose-input {
    margin: 0 1 0 0;
    height: 3;
}

#send-btn {
    height: 3;
    margin: 0 1 0 0;
    background: #d97757;
    color: #1c0f07;
    border: none;
    text-style: bold;
}

#send-btn:hover {
    background: #ff8a5c;
}

#broadcast-btn {
    height: 3;
    background: #241d28;
    color: #c792ea;
    border: solid #3b3350;
}

#broadcast-btn:hover {
    background: #3b3350;
    color: #efe9e0;
}

/* ─── DataTable ───────────────────────────────────────────────────────────── */

DataTable {
    background: #0e0c12;
    color: #bcb1c6;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: #15131c;
    color: #5fd4ff;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: #241d28;
    color: #ff8a5c;
}

DataTable > .datatable--cursor {
    background: #241d28;
    color: #efe9e0;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: #111018;
}

DataTable > .datatable--odd-row {
    background: #0e0c12;
}

DataTable > .datatable--hover {
    background: #1c1825;
}

/* ─── Input ───────────────────────────────────────────────────────────────── */

Input {
    background: #09080d;
    color: #efe9e0;
    border: solid #262230;
}

Input:focus {
    border: tall #d97757;
}

Input > .input--placeholder {
    color: #5f566c;
}

/* ─── Button ──────────────────────────────────────────────────────────────── */

Button {
    background: #241d28;
    color: #efe9e0;
    border: solid #3b3350;
}

Button:hover {
    background: #3b3350;
}

Button.-primary {
    background: #d97757;
    color: #1c0f07;
    border: none;
    text-style: bold;
}

Button.-primary:hover {
    background: #ff8a5c;
}

/* ─── Log ─────────────────────────────────────────────────────────────────── */

Log {
    background: #100e16;
    color: #bcb1c6;
    padding: 0;
}

/* ─── Select & options ────────────────────────────────────────────────────── */

Select {
    background: #09080d;
    color: #efe9e0;
    border: solid #262230;
    padding: 0 1;
}

Select:focus {
    border: tall #d97757;
}

SelectOverlay > Option {
    background: #0e0c12;
    color: #bcb1c6;
    padding: 0 1;
}

SelectOverlay > Option:hover {
    background: #1c1825;
    color: #efe9e0;
}

SelectOverlay > Option.-highlighted {
    background: #241d28;
    color: #ff8a5c;
}

/* ─── ScrollableContainer ─────────────────────────────────────────────────── */

ScrollableContainer {
    scrollbar-color: #3b3350;
    scrollbar-color-hover: #d97757;
    scrollbar-background: #0e0c12;
    scrollbar-background-hover: #111018;
}
/* ─── Toast Notifications ─────────────────────────────────────────────────── */

Toast {
    background: #15131c;
    border: tall #d97757;
    color: #efe9e0;
}

ToastTitle {
    color: #ff8a5c;
    text-style: bold;
}

ToastDescription {
    color: #bcb1c6;
}

Toast.-information {
    border: tall #5fd4ff;
    background: #0e1c26;
}

Toast.-information ToastTitle {
    color: #5fd4ff;
}

Toast.-warning {
    border: tall #ffd166;
    background: #2a2008;
}

Toast.-warning ToastTitle {
    color: #ffd166;
}

Toast.-error {
    border: tall #ff5d6b;
    background: #2a0f14;
}

Toast.-error ToastTitle {
    color: #ff5d6b;
}

Toast.-success {
    border: tall #3ddc97;
    background: #0d241b;
}

Toast.-success ToastTitle {
    color: #3ddc97;
}

/* ─── Modal dialog (NewSessionScreen) ────────────────────────────────────── */

NewSessionScreen {
    align: center middle;
    background: rgba(14, 12, 18, 0.82);
}

#dialog {
    background: #15131c;
    border: double #d97757;
    padding: 2 3;
    width: 64;
    height: auto;
    max-height: 80%;
}

#dialog-title {
    color: #ffd166;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: tall #262230;
}

#dialog Label {
    color: #c792ea;
    margin-top: 1;
}

#dialog-buttons {
    margin-top: 2;
    align: right middle;
    height: 3;
}

#create-btn {
    margin-right: 1;
    background: #d97757;
    border: none;
    color: #1c0f07;
}

#create-btn:hover {
    background: #ff8a5c;
}

#cancel-btn {
    background: #241d28;
    border: solid #3b3350;
    color: #968ba2;
}

/* ─── Status colour helpers ───────────────────────────────────────────────── */

.status-idle        { color: #968ba2; }
.status-working     { color: #3ddc97; }
.status-active      { color: #3ddc97; }
.status-blocked     { color: #ff5d6b; }
.status-done        { color: #5fd4ff; }
.status-completed   { color: #2be0c8; }
.status-error       { color: #ff5d6b; }
.status-failed      { color: #ff5d6b; }
.status-unreachable { color: #ffd166; }
.status-paused      { color: #ffd166; }
/* ─── ProgressBar ─────────────────────────────────────────────────────────── */

ProgressBar {
    height: 1;
}

ProgressBar > .bar--complete {
    color: #3ddc97;
}

ProgressBar > .bar--indeterminate {
    color: #5fd4ff;
}

ProgressBar > .bar--bar {
    color: #262230;
}

/* ─── Perf HUD ───────────────────────────────────────────────────────────── */

#perf-hud {
    background: rgba(21, 19, 28, 0.94);
    border: tall #3b3350;
    color: #968ba2;
    dock: right;
    width: 34;
    height: auto;
    max-height: 50%;
    padding: 1;
    layer: overlay;
    visibility: hidden;
}

#perf-hud.visible {
    visibility: visible;
}

.perf-title {
    color: #ffd166;
    text-style: bold;
    border-bottom: solid #262230;
    margin-bottom: 1;
}

.perf-row {
    color: #968ba2;
    height: 1;
}

.perf-label {
    color: #5f566c;
}

.perf-value {
    color: #5fd4ff;
    text-style: bold;
}

/* ─── Boot screen ─────────────────────────────────────────────────────────── */

BootScreen {
    background: #0e0c12;
    align: center middle;
}

#boot-box {
    width: auto;
    height: auto;
    align: center middle;
}

#boot-logo {
    color: #efe9e0;
    text-align: center;
    height: 7;
}

#boot-status {
    height: 1;
    text-align: center;
    color: #968ba2;
    margin-top: 1;
}

#boot-bar {
    height: 1;
    text-align: center;
    margin-top: 1;
}

#boot-hint {
    color: #5f566c;
    text-align: center;
    margin-top: 1;
}

#boot-version {
    color: #5f566c;
    dock: bottom;
    height: 1;
    padding: 0 2;
    text-align: right;
}

/* ─── ASCII loader widgets ────────────────────────────────────────────────── */

AsciiLoading {
    height: 1;
    color: #5fd4ff;
    margin: 0 1;
}

ProgressBarLoader {
    height: 1;
    margin: 0 1;
}

/* ─── Loader showcase screen ──────────────────────────────────────────────── */

#loader-showcase {
    width: auto;
    height: auto;
    margin: 3 6;
    padding: 0;
    border: tall #262230;
    background: #15131c;
    align: left top;
}

#showcase-title {
    color: #ffd166;
    text-style: bold;
    padding: 1 1;
    border-bottom: solid #262230;
    background: #1c1825;
}

#showcase-spacer {
    height: 1;
}

#showcase-hint {
    color: #5f566c;
    margin: 1 1;
}

/* ─── LoadingIndicator (built-in) ─────────────────────────────────────────── */

LoadingIndicator {
    color: #ff8a5c;
    background: rgba(21, 19, 28, 0.9);
}